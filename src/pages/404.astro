---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = "Page Not Found | De Dios Law DPO Services";
const description = "The page you were looking for could not be found. Return to the De Dios Law DPO homepage or contact us for data privacy compliance assistance.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="section">
				<div class="container">
					<div class="max-w-2xl mx-auto text-center">
						<p class="text-5xl md:text-6xl font-bold text-primary-600 mb-4">404</p>
						<h1 class="text-3xl md:text-4xl font-bold text-primary-900 mb-4">Page Not Found</h1>
						<p class="text-lg text-neutral-600 mb-8">
							Sorry, the page you were looking for doesn't exist or has moved.
						</p>
						<div class="flex flex-col sm:flex-row gap-4 justify-center">
							<a href="/" class="btn-primary">Back to Home</a>
							<a href="/contact" class="btn-secondary">Contact Us</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
